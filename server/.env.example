# ---- 服务 ----
PUZZLE_APP_NAME=shuhui-server
PUZZLE_DEBUG=false

# ---- 存储 ----
# 默认 SQLite；换成 postgresql+psycopg://user:pass@host/db 也能跑（SQLAlchemy 通用）
PUZZLE_DATABASE_URL=sqlite:///./var/puzzle.db
# 留空则自动探测 localhost:6379
PUZZLE_REDIS_URL=redis://localhost:6379/0
# auto 探测失败自动降级 | redis 必须连上（连不上就启动失败）| memory 直接用进程内实现
PUZZLE_STORAGE_MODE=auto

# ---- 题池 ----
PUZZLE_POOL_FILE=data/pool.json
PUZZLE_SEED_ON_STARTUP=true

# ---- 鉴权 ----
# 生产环境务必换掉，且长度不短于 32 字节
PUZZLE_JWT_SECRET=please-change-this-to-a-long-random-string
PUZZLE_JWT_EXPIRE_MINUTES=10080
PUZZLE_BCRYPT_ROUNDS=12

# ---- 每日挑战 ----
# 按东八区切日，全球玩家拿到同一道题
PUZZLE_DAILY_TZ_OFFSET_HOURS=8
# 服务端计时窗口：早于下限（疑似脚本）或晚于上限（超时）都不计榜单
PUZZLE_MIN_ELAPSED_MS=3000
PUZZLE_MAX_ELAPSED_MS=21600000

# ---- 限流 ----
PUZZLE_RATE_LIMIT_AUTH=20
PUZZLE_RATE_LIMIT_SUBMIT=60
PUZZLE_RATE_LIMIT_READ=300
PUZZLE_AUTH_WINDOW=60
PUZZLE_SUBMIT_WINDOW=60
PUZZLE_READ_WINDOW=60
